# Environment variables template (fill these before running)

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bandari?retryWrites=true&w=majority
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=very_long_nextauth_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_FROM="Bandari Capital <Bandaricapital@gmail.com>"

# Stock API (example: FINNHUB)
STOCK_API_PROVIDER=finnhub
STOCK_API_KEY=your_stock_api_key

# Optional: set site metadata
SITE_NAME="Bandari Capital"
